{
  "$schema": "https://dl.viam.dev/module.schema.json",
  "module_id": "viam:mirka",
  "visibility": "public_unlisted",
  "url": "https://github.com/viam-modules/mirka",
  "description": "Viam module for Mirka robotic sanding hardware",
  "markdown_link": "README.md",
  "models": [
    {
      "api": "rdk:component:generic",
      "model": "viam:mirka:airos-550cv",
      "short_description": "Mirka AIROS 550CV orbital sander via Modbus RTU motor drive cabinet"
    },
    {
      "api": "rdk:component:gantry",
      "model": "viam:mirka:autochanger-remover",
      "short_description": "Mirka AutoChanger remover knife, a single-axis gantry via IFM AL1342 IO-Link master"
    },
    {
      "api": "rdk:service:generic",
      "model": "viam:mirka:autochanger-remover-svc",
      "short_description": "Runs the Mirka AutoChanger disc-removal cycle: arm waypoints and knife moves in the manual's order"
    }
  ],
  "entrypoint": "bin/viam-mirka",
  "first_run": "first_run.sh",
  "build": {
    "build": "make module.tar.gz",
    "setup": "make setup",
    "path": "module.tar.gz",
    "arch": [
      "linux/arm64",
      "linux/amd64",
      "darwin/arm64"
    ]
  }
}
